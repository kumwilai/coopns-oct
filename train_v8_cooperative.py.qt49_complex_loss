        print(f"\n┌{'─'*76}┐")
        print(f"│ {'GT-FREE PREDICATES':<24} {'Backbone':>12} {'Corrected':>12} {'Delta':>10} {'Status':>12} │")
        print(f"├{'─'*76}┤")

        pred_names = {
